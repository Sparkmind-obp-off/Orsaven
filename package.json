{
  "name": "orsaven",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply orsaven-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply orsaven-production --remote",
    "db:seed:local": "wrangler d1 execute orsaven-production --local --file=./seed/demo.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name orsaven --branch main"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.9",
    "@clerk/clerk-react": "^5.61.12",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "hono": "^4.13.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^12.11.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
